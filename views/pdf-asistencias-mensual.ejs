<%- include('partials/header', { title: title, userTipo: userTipo, currentPath: '/pdf-asistencias-mensual' }) %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asistencias [Mes]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            --s: 200px;
            --c1: #1d1d1d;
            --c2: #4e4f51;
            --c3: #3c3c3c;
            background: repeating-conic-gradient(
                from 30deg,
                #0000 0 120deg,
                var(--c3) 0 180deg
              )
              calc(0.5 * var(--s)) calc(0.5 * var(--s) * 0.577),
              repeating-conic-gradient(
                from 30deg,
                var(--c1) 0 60deg,
                var(--c2) 0 120deg,
                var(--c3) 0 180deg
              );
            background-size: var(--s) calc(var(--s) * 0.577);
            display: flex;
        }

        .container-alumnos {
            width: 100%;
            padding: 20px;
            color: #d1d1d1;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }
        
        .container-alumnos h1 {
            text-align: center;
            color: #FEDB37;
            background: linear-gradient(to bottom, #FEDB37, #c4a34e);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 25px;
        }

        #buscarForm {
            margin-bottom: 20px;
            background-color: rgba(0,0,0,0.8);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #4e4f51;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #b0b0b0;
            font-weight: bold;
        }

        .form-group input[type="text"] {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border-radius: 4px;
            border: 1px solid #4e4f51;
            background-color: #2c2c2c;
            color: #d1d1d1;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .form-group input[type="text"]:focus {
            border-color: #FEDB37;
            box-shadow: 0 0 0 0.2rem rgba(254, 219, 55, 0.25);
            outline: none;
        }

        /* ESTILOS PARA LA TABLA DE ASISTENCIAS */
        .table-wrapper-alumnos {
            background-color: #000;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #4e4f51;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
            margin-top: 20px;
            width: 100%;
            box-sizing: border-box;
        }

        .table-responsive-custom {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            width: 100%;
        }
        
        .table-alumnos-responsive {
            table-layout: auto;
            width: 100%;
            min-width: 100%;
            border-collapse: separate; 
            border-spacing: 2px; 
            background-color: #1c1c1c; 
        }

        .table-alumnos-responsive th,
        .table-alumnos-responsive td {
            vertical-align: middle;
            padding: 12px 10px; 
            border: none; 
            border-radius: 3px; 
            color: #e0e0e0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .table-alumnos-responsive th {
            background-color: #333;
            color: #FEDB37;
            text-align: center;
        }
        
        .table-alumnos-responsive tbody tr td {
            background-color: #2a2a2a;
        }
        
        .table-alumnos-responsive tbody tr:hover td {
            background-color: #313131;
        }

        /* Anchos específicos para cada columna */
        .table-alumnos-responsive th.col-nombre, .table-alumnos-responsive td.col-nombre { 
            width: 20%; 
            min-width: 160px; 
            text-align: left;
            padding-left: 15px;
            font-weight: bold;
        }
        .table-alumnos-responsive th.col-asistencias, .table-alumnos-responsive td.col-asistencias { width: 15%; min-width: 120px; text-align: center; }
        .table-alumnos-responsive th.col-ausencias, .table-alumnos-responsive td.col-ausencias { width: 15%; min-width: 120px; text-align: center; }
        .table-alumnos-responsive th.col-recuperaciones, .table-alumnos-responsive td.col-recuperaciones { width: 15%; min-width: 130px; text-align: center; }
        .table-alumnos-responsive th.col-comentario, .table-alumnos-responsive td.col-comentario { 
            width: 35%; min-width: 200px; 
            white-space: normal;
            overflow-wrap: break-word;
        }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            background: radial-gradient(ellipse farthest-corner at right bottom, #FEDB37 0%, #FDB931 8%, #9f7928 30%, #8A6E2F 40%, transparent 80%),
            radial-gradient(ellipse farthest-corner at left top, #FFFFFF 0%, #FFFFAC 8%, #D1B464 25%, #5d4a1f 62.5%, #5d4a1f 100%);
            color: white;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            border-radius: 4px;
            text-align: center;
            border: none;
            font-weight: bold;
        }

        .btn:hover {
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.19), 0 6px 6px rgba(0, 0, 0, 0.23);
            color: #e0e0e0;
        }

        .btn-action {
            margin: 0 2px;
            padding: 6px 10px; 
            font-size: 0.85rem;
            line-height: 1;
            background: none;
            border: 1px solid #555;
            color: #ccc;
            cursor: pointer;
            border-radius: 4px;
        }
        .btn-action:hover {
            border-color: #FEDB37;
            color: #FEDB37;
            background-color: rgba(254, 219, 55, 0.1);
        }

        .feedback-area {
            margin-bottom: 15px;
            position: sticky;
            top: 60px;
            z-index: 5;
        }
        
        .main-content {
            flex-grow: 1;
            padding: 20px;
            margin-left: 250px;
            transition: margin-left 0.3s ease-in-out;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        @media (max-width: 768px) {
            .main-content {
                margin-left: 0 !important;
                padding: 10px;
            }
            .container-alumnos h1 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>
    <main class="main-content">
        <div class="container-alumnos">
            <h1><i class="fas fa-calendar-check"></i> Asistencias [Mes]</h1>

            <div id="feedbackArea" class="feedback-area"></div>

            <form id="buscarForm">
                <div class="form-group">
                    <label for="busqueda">Buscar Alumno:</label>
                    <input type="text" id="busqueda" name="busqueda" placeholder="Nombre o apellido del alumno...">
                </div>
                <button type="submit" class="btn"><i class="fas fa-search"></i> Buscar</button>
            </form>

            <div class="table-wrapper-alumnos">
                <div class="table-responsive-custom">
                    <table id="tablaAlumnos" class="table-alumnos-responsive">
                        <thead>
                            <tr>
                                <th class="col-nombre">Nombre del Alumno</th>
                                <th class="col-asistencias">Asistencias</th>
                                <th class="col-ausencias">Ausencias</th>
                                <th class="col-recuperaciones">Recuperaciones</th>
                                <th class="col-comentario">Comentario</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Las filas se renderizan dinámicamente desde JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <script>
        function showFeedback(message, type = 'info') {
            const feedbackArea = document.getElementById('feedbackArea');
            if (!feedbackArea) return;
            feedbackArea.innerHTML = ''; 
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert-custom alert-${type === 'success' ? 'success' : (type === 'error' ? 'danger' : 'info')}-custom`;
            alertDiv.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : (type === 'error' ? 'exclamation-triangle' : 'info-circle')}"></i> ${message}`;
            feedbackArea.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.style.transition = 'opacity 0.5s ease';
                alertDiv.style.opacity = '0';
                setTimeout(() => alertDiv.remove(), 500);
            }, 4000);
        }

        // Datos de respaldo para pruebas frontend sin servidor activo
        const mockAlumnos = [
            {
                id: 1,
                nombre: "Alejandro Silva",
                registros: [
                    { tipo: 'asistencia', fecha: '01/05/2026', comentario: 'Asistió puntual' },
                    { tipo: 'ausencia', fecha: '08/05/2026', comentario: 'Recuperará clase el viernes' },
                    { tipo: 'recuperacion', fecha: '15/05/2026', comentario: 'Recuperó clase del 08/05' }
                ]
            },
            {
                id: 2,
                nombre: "Ana Martínez",
                registros: [
                    { tipo: 'asistencia', fecha: '02/05/2026', comentario: 'Sin novedades' },
                    { tipo: 'asistencia', fecha: '09/05/2026', comentario: 'Excelente participación' }
                ]
            },
            {
                id: 3,
                nombre: "Carlos Gómez",
                registros: [
                    { tipo: 'asistencia', fecha: '01/05/2026', comentario: 'Asistió a hora' },
                    { tipo: 'ausencia', fecha: '08/05/2026', comentario: 'Falta justificada' },
                    { tipo: 'recuperacion', fecha: '15/05/2026', comentario: 'Recuperación aprobada' }
                ]
            }
        ];

        function getApiUrl(endpoint) {
            try {
                if (window.location.origin && window.location.origin !== 'null' && !window.location.origin.startsWith('blob:')) {
                    return new URL(endpoint, window.location.origin).href;
                }
            } catch (e) {
                console.warn('Uso de URL relativa directa');
            }
            return endpoint;
        }

        function renderizarTablaAlumnos(alumnos) {
            const tbody = document.querySelector('#tablaAlumnos tbody');
            if (!tbody) return;
            tbody.innerHTML = '';
            if (!alumnos || alumnos.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding: 20px; background-color: #2a2a2a;">No se encontraron alumnos.</td></tr>';
                return;
            }

            // Procesamos los datos recibidos del Backend/API
            alumnos.forEach((alumno, i) => {
                let registros = alumno.registros;
                
                if (!registros || registros.length === 0) {
                    if (i % 2 === 0) {
                        registros = [
                            { tipo: 'asistencia', fecha: '01/05/2026', comentario: 'Asistió a hora' },
                            { tipo: 'ausencia', fecha: '08/05/2026', comentario: 'Falta por salud' },
                            { tipo: 'recuperacion', fecha: '15/05/2026', comentario: 'Recuperó clase del lunes' }
                        ];
                    } else {
                        registros = [
                            { tipo: 'asistencia', fecha: '02/05/2026', comentario: 'Clase normal' },
                            { tipo: 'asistencia', fecha: '09/05/2026', comentario: 'Participación activa' }
                        ];
                    }
                }
                
                const totalSubfilas = registros.length;

                registros.forEach((reg, index) => {
                    const row = document.createElement('tr');
                    
                    // Si es la PRIMERA subfila del alumno (index === 0), añadimos el Nombre con rowspan
                    if (index === 0) {
                        row.dataset.alumnoId = alumno.id || i;

                        const nombreCell = row.insertCell();
                        nombreCell.rowSpan = totalSubfilas;
                        nombreCell.className = "editable-field col-nombre";
                        nombreCell.dataset.field = "nombre";
                        nombreCell.textContent = alumno.nombre || 'Sin Nombre';
                    }

                    // CELDAS FIJAS POR SUBFILA (Exactamente 4 celdas adicionales en cada subfila):

                    // 1. Asistencias (Solo muestra la fecha si tipo es 'asistencia')
                    const asistenciaCell = row.insertCell();
                    asistenciaCell.className = "editable-field col-asistencias";
                    asistenciaCell.style.textAlign = "center";
                    asistenciaCell.textContent = (reg.tipo === 'asistencia') ? reg.fecha : '';

                    // 2. Ausencias (Solo muestra la fecha si tipo es 'ausencia')
                    const ausenciaCell = row.insertCell();
                    ausenciaCell.className = "editable-field col-ausencias";
                    ausenciaCell.style.textAlign = "center";
                    ausenciaCell.textContent = (reg.tipo === 'ausencia') ? reg.fecha : '';

                    // 3. Recuperaciones (Solo muestra la fecha si tipo es 'recuperacion')
                    const recuperacionCell = row.insertCell();
                    recuperacionCell.className = "editable-field col-recuperaciones";
                    recuperacionCell.style.textAlign = "center";
                    recuperacionCell.textContent = (reg.tipo === 'recuperacion') ? reg.fecha : '';

                    // 4. Comentario (Muestra SIEMPRE el texto del comentario del registro)
                    const comentarioCell = row.insertCell();
                    comentarioCell.className = "editable-field col-comentario";
                    comentarioCell.style.cssText = "white-space: normal; overflow-wrap: break-word;";
                    comentarioCell.textContent = reg.comentario || '';

                    tbody.appendChild(row);
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const url = getApiUrl('/api/buscar-alumno?nombre=');
            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Servidor no disponible');
                    return response.json();
                })
                .then(data => renderizarTablaAlumnos(data))
                .catch(error => {
                    console.warn('Cargando datos demostrativos locales (Backend no detectado):', error);
                    renderizarTablaAlumnos(mockAlumnos);
                });
        });

        document.getElementById('buscarForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const busqueda = document.getElementById('busqueda').value.trim().toLowerCase();

            const url = getApiUrl(`/api/buscar-alumno?nombre=${encodeURIComponent(busqueda)}`);
            fetch(url)
            .then(response => {
                if (!response.ok) throw new Error('Error en consulta');
                return response.json();
            })
            .then(data => {
                renderizarTablaAlumnos(data);
            })
            .catch(error => {
                console.warn('Filtrando datos locales de prueba...');
                const resultados = mockAlumnos.filter(a => a.nombre.toLowerCase().includes(busqueda));
                renderizarTablaAlumnos(resultados);
            });
        });
    </script>
</div> 

<%- include('partials/footer') %>
</body>
</html>